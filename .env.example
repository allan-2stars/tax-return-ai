# ── Edition ───────────────────────────────────────────────────────────────────
# personal | pro | team
EDITION=personal

# ── Financial Year ────────────────────────────────────────────────────────────
# Default FY for new sessions. Australian FY = 1 Jul – 30 Jun.
FINANCIAL_YEAR=2025-2026

# ── AI Provider ───────────────────────────────────────────────────────────────
# anthropic | openai | deepseek | mock
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-20250514
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=                        # leave blank if not using OpenAI
DEEPSEEK_API_KEY=                      # leave blank if not using DeepSeek
DEEPSEEK_BASE_URL=https://api.deepseek.com


# DeepSeek (recommended for this new support)
AI_PROVIDER=deepseek
AI_MODEL=deepseek-v4-flash   # or deepseek-v4-pro
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-...
# Optional if using OpenAI-compatible proxy for OpenAI mode only:
# OPENAI_BASE_URL=https://your-openai-compatible-endpoint

# Anthropic
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-20250514
ANTHROPIC_API_KEY=sk-ant-...

# Mock (no cloud key required)
AI_PROVIDER=mock

# ── OCR Provider ──────────────────────────────────────────────────────────────
# pdfplumber | tesseract | mock
OCR_PROVIDER=pdfplumber

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (personal/pro):    sqlite+aiosqlite:///./data/taxapp.db
# PostgreSQL (team):        postgresql+asyncpg://user:pass@db:5432/taxapp
DATABASE_URL=sqlite+aiosqlite:///./data/taxapp.db

# ── Storage ───────────────────────────────────────────────────────────────────
# local | s3
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/uploads      # relative — never absolute

# S3-compatible (team/pro-cloud)
AWS_BUCKET=                            # leave blank if not using S3
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=20
LOG_LEVEL=INFO
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
ALLOW_INSECURE_COOKIE_LOCAL_DEV=false
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
# Optional explicit second-based overrides:
# SESSION_IDLE_TIMEOUT_SECONDS=1800
# SESSION_ABSOLUTE_TIMEOUT_SECONDS=43200

# ── Privacy ───────────────────────────────────────────────────────────────────
# Never log raw document text or sensitive fields. See ADR 004.
REDACT_SENSITIVE_LOGS=true
TELEMETRY_ENABLED=false                # opt-in only for local editions
