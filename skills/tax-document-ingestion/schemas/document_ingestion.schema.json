{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tax-return-ai:document_ingestion:1.1",
  "title": "DocumentIngestionResult",
  "description": "Output of the document ingestion pipeline. Financial year validated at ingestion.",
  "type": "object",
  "required": [
    "schema_version",
    "document_id",
    "financial_year",
    "original_file",
    "status",
    "document_type",
    "extraction",
    "candidate_fields",
    "duplicate_check",
    "audit"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.1" },
    "document_id": { "type": "string", "minLength": 1 },
    "tax_session_id": { "type": ["string", "null"] },
    "financial_year": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{4}$",
      "description": "Australian FY of the session this document belongs to. e.g. '2025-2026'."
    },
    "original_file": {
      "type": "object",
      "required": ["filename", "mime_type", "size_bytes", "sha256", "storage_uri", "uploaded_at"],
      "additionalProperties": false,
      "properties": {
        "filename": { "type": "string" },
        "mime_type": { "type": "string" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "description": "SHA-256 hex digest for deduplication." },
        "storage_uri": { "type": "string" },
        "uploaded_at": { "type": "string" },
        "source_channel": { "type": ["string", "null"] }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "uploaded", "stored", "text_extracted", "ocr_required", "ocr_completed",
        "extraction_failed", "normalised", "duplicate_detected",
        "ready_for_classification", "needs_user_review"
      ]
    },
    "document_type": {
      "type": "string",
      "enum": [
        "receipt", "tax_invoice", "payslip", "income_statement", "bank_statement",
        "donation_receipt", "membership_fee_receipt", "insurance_statement",
        "work_equipment_invoice", "email_body", "email_attachment", "unknown"
      ]
    },
    "extraction": {
      "type": "object",
      "required": ["method", "raw_text", "confidence"],
      "additionalProperties": false,
      "properties": {
        "method": { "type": "string", "enum": ["pdf_text", "ocr", "email_parser", "csv_parser", "manual", "failed"] },
        "raw_text": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "page_count": { "type": ["integer", "null"], "minimum": 0 },
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["page_number", "text"],
            "additionalProperties": false,
            "properties": {
              "page_number": { "type": "integer", "minimum": 1 },
              "text": { "type": "string" },
              "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
            }
          }
        },
        "failure_reason": { "type": ["string", "null"] }
      }
    },
    "candidate_fields": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "date": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "date_in_financial_year": {
          "type": ["boolean", "null"],
          "description": "True if candidate_fields.date falls within financial_year. Set at ingestion."
        },
        "amount": { "type": ["number", "null"] },
        "currency": { "type": "string", "default": "AUD" },
        "supplier_or_source": { "type": ["string", "null"] },
        "abn": { "type": ["string", "null"] },
        "invoice_number": { "type": ["string", "null"] },
        "payment_method": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] }
      }
    },
    "missing_or_uncertain_fields": {
      "type": "array",
      "items": { "type": "string" }
    },
    "fy_date_warning": {
      "type": ["string", "null"],
      "description": "Set when candidate_fields.date is outside financial_year. e.g. 'Date 2024-06-15 is outside FY 2025-2026 (1 Jul 2025 – 30 Jun 2026).'"
    },
    "duplicate_check": {
      "type": "object",
      "required": ["status", "matched_document_ids"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["not_duplicate", "possible_duplicate", "confirmed_duplicate"] },
        "matched_document_ids": { "type": "array", "items": { "type": "string" } },
        "reason": { "type": ["string", "null"] }
      }
    },
    "audit": {
      "type": "object",
      "required": ["created_at", "processor", "events"],
      "additionalProperties": false,
      "properties": {
        "created_at": { "type": "string" },
        "processor": { "type": "string" },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["timestamp", "event", "status"],
            "additionalProperties": false,
            "properties": {
              "timestamp": { "type": "string" },
              "event": { "type": "string" },
              "status": { "type": "string" },
              "detail": { "type": ["string", "null"] }
            }
          }
        }
      }
    }
  }
}
