{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tax-return-ai:tax_analysis_output:1.1",
  "title": "TaxAnalysisOutput",
  "description": "Classified tax item from the tax-return-specialist skill. Australian FY = 1 July – 30 June.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "financial_year",
    "document_id",
    "item_type",
    "category",
    "amount",
    "currency",
    "date",
    "supplier_or_source",
    "description",
    "confidence",
    "evidence_status",
    "risk_level",
    "review_status",
    "reasoning_summary",
    "missing_fields",
    "suggested_user_questions",
    "source_evidence",
    "audit"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.1" },
    "financial_year": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{4}$",
      "description": "Australian FY e.g. '2025-2026' = 1 Jul 2025 – 30 Jun 2026."
    },
    "document_id": { "type": "string", "minLength": 1 },
    "parent_document_id": { "type": ["string", "null"] },
    "item_id": { "type": ["string", "null"] },
    "item_type": {
      "type": "string",
      "enum": ["income", "deduction", "non_claimable", "needs_review", "out_of_scope"]
    },
    "category": {
      "type": "string",
      "enum": [
        "salary_wages", "allowance", "bank_interest", "dividend",
        "government_payment", "other_income", "unknown_income",
        "foreign_income", "business_income", "rental_income",
        "capital_gain", "crypto_gain", "trust_distribution",
        "work_related_car_expense", "work_related_travel_expense",
        "work_related_clothing_laundry", "work_related_self_education",
        "work_from_home", "tools_equipment", "union_fee",
        "professional_membership_fee", "donation", "tax_agent_fee",
        "income_protection", "other_deduction", "unknown_deduction",
        "personal_expense", "private_or_mixed_use", "insufficient_evidence",
        "duplicate_document", "reimbursed_or_potential_double_dip",
        "out_of_scope", "needs_review"
      ]
    },
    "amount": { "type": ["number", "null"], "minimum": 0 },
    "work_use_percentage": {
      "type": ["number", "null"], "minimum": 0, "maximum": 100,
      "description": "Work-use % for mixed-use deductions."
    },
    "currency": { "type": "string", "enum": ["AUD"] },
    "date": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "date_in_financial_year": {
      "type": ["boolean", "null"],
      "description": "True if date falls within financial_year. Null if date is null."
    },
    "supplier_or_source": { "type": ["string", "null"] },
    "abn": {
      "type": ["string", "null"],
      "description": "Australian Business Number if visible on document."
    },
    "description": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence_status": {
      "type": "string",
      "enum": ["complete", "partial", "missing_or_incomplete"]
    },
    "risk_level": { "type": "string", "enum": ["low", "medium", "high"] },
    "review_status": {
      "type": "string",
      "enum": ["auto_classified", "needs_user_review", "needs_tax_agent_review",
               "user_confirmed", "excluded_by_user", "ready_for_export"]
    },
    "reasoning_summary": { "type": "string", "minLength": 1 },
    "alternative_interpretations": {
      "type": "array", "items": { "type": "string" }, "default": []
    },
    "missing_fields": { "type": "array", "items": { "type": "string" } },
    "suggested_user_questions": { "type": "array", "items": { "type": "string" } },
    "source_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "snippet", "bounding_box", "ocr_confidence"],
      "properties": {
        "original_filename": { "type": ["string", "null"] },
        "file_hash": { "type": ["string", "null"], "description": "SHA-256 hex of original file." },
        "page": { "type": ["integer", "null"], "minimum": 1 },
        "snippet": { "type": ["string", "null"] },
        "bounding_box": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": { "type": "number" }, "y": { "type": "number" },
            "width": { "type": "number" }, "height": { "type": "number" }
          }
        },
        "ocr_confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analysis_timestamp", "analysis_method", "user_confirmed", "model_version"],
      "properties": {
        "analysis_timestamp": { "type": "string" },
        "analysis_method": { "type": "string", "enum": ["ai", "rules", "manual", "hybrid"] },
        "user_confirmed": { "type": "boolean" },
        "user_confirmed_at": { "type": ["string", "null"] },
        "model_version": { "type": ["string", "null"] },
        "skill_version": { "type": ["string", "null"] },
        "correction_history": {
          "type": "array",
          "description": "Append-only. Never remove entries.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "previous_value", "new_value", "corrected_at", "corrected_by"],
            "properties": {
              "field": { "type": "string" },
              "previous_value": {},
              "new_value": {},
              "corrected_at": { "type": "string" },
              "corrected_by": { "type": "string", "enum": ["user", "system", "tax_agent"] }
            }
          },
          "default": []
        }
      }
    }
  },
  "$defs": {
    "BatchSummary": {
      "title": "BatchSummary",
      "type": "object",
      "additionalProperties": false,
      "required": ["financial_year", "total_items"],
      "properties": {
        "financial_year": { "type": "string", "pattern": "^\\d{4}-\\d{4}$" },
        "total_items": { "type": "integer", "minimum": 0 },
        "income_count": { "type": "integer", "minimum": 0 },
        "deduction_count": { "type": "integer", "minimum": 0 },
        "needs_review_count": { "type": "integer", "minimum": 0 },
        "out_of_scope_count": { "type": "integer", "minimum": 0 },
        "high_risk_count": { "type": "integer", "minimum": 0 },
        "total_income_aud": { "type": ["number", "null"] },
        "total_candidate_deductions_aud": { "type": ["number", "null"] },
        "has_out_of_scope": { "type": "boolean" },
        "has_duplicates": { "type": "boolean" }
      }
    }
  }
}
